---
import '../../styles/global.css';
import ordersData from '../../data/orders.json';
import reviewsData from '../../data/reviews.json';

const title = "Food Reviews | Shelldon Brooks";
const description = "Ehrliche Reviews von Lieferanten und Restaurants in München.";

function toSlug(name: string): string {
  return name.toLowerCase()
    .replace(/⚠️|🚨/g, '')
    .trim()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
}

function parseDateStr(date: string | undefined, year: number): string {
  if (!date) return `${year}-01-01`;
  const parts = date.replace(/\.$/, '').split('.');
  if (parts.length >= 2) {
    const day = parts[0].padStart(2, '0');
    const month = parts[1].padStart(2, '0');
    return `${year}-${month}-${day}`;
  }
  return `${year}-01-01`;
}

function getLastOrderDate(slug: string): string | undefined {
  const restaurant = (ordersData as Record<string, { orders: { date: string }[] }>)[slug];
  if (!restaurant?.orders?.length) return undefined;
  return restaurant.orders.reduce(
    (latest, order) => (order.date > latest ? order.date : latest),
    restaurant.orders[0].date
  );
}

const allReviews = (reviewsData as {
  year: number; name: string; cuisine: string; rating: number; notes?: string; date?: string
}[]).map(review => {
  const slug = toSlug(review.name);
  const lastOrderDate = getLastOrderDate(slug);
  const reviewDateISO = parseDateStr(review.date, review.year);
  const sortKey = lastOrderDate && lastOrderDate > reviewDateISO ? lastOrderDate : reviewDateISO;
  const displayYear = parseInt(sortKey.split('-')[0]);
  return { ...review, slug, lastOrderDate, sortKey, displayYear };
});

allReviews.sort((a, b) => b.sortKey.localeCompare(a.sortKey));

const totalReviews = allReviews.length;
const topCount    = allReviews.filter(r => r.rating >= 3).length;
const avoidCount  = allReviews.filter(r => r.rating < 0).length;
const orderCount  = Object.keys(ordersData).length;

const reviewsJSON = JSON.stringify(allReviews);
---

<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
</head>
<body class="bg-[#0b0f1a] text-[#e2e8f0] min-h-screen font-sans antialiased">

  <!-- Header -->
  <header class="border-b border-sky-400/10">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 py-5 flex items-center gap-4">
      <a href="/" class="text-slate-500 hover:text-sky-400 transition-colors text-sm shrink-0">← Home</a>
      <div>
        <h1 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">🍽️ Food Reviews</h1>
        <p class="text-slate-500 text-sm mt-0.5">Ehrliche Reviews aus München – Lieferung & Restaurant</p>
      </div>
    </div>
  </header>

  <main class="max-w-3xl mx-auto px-4 sm:px-6 py-8 pb-20">

    <!-- Stats bar -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
      <div class="bg-[#121828] border border-sky-400/10 rounded-xl p-3 text-center">
        <div class="text-2xl font-bold text-white">{totalReviews}</div>
        <div class="text-xs text-slate-500 mt-0.5">Reviews</div>
      </div>
      <div class="bg-[#121828] border border-sky-400/10 rounded-xl p-3 text-center">
        <div class="text-2xl font-bold text-emerald-400">{topCount}</div>
        <div class="text-xs text-slate-500 mt-0.5">Empfehlenswert</div>
      </div>
      <div class="bg-[#121828] border border-sky-400/10 rounded-xl p-3 text-center">
        <div class="text-2xl font-bold text-red-400">{avoidCount}</div>
        <div class="text-xs text-slate-500 mt-0.5">Eher nein</div>
      </div>
      <div class="bg-[#121828] border border-sky-400/10 rounded-xl p-3 text-center">
        <div class="text-2xl font-bold text-sky-400">{orderCount}</div>
        <div class="text-xs text-slate-500 mt-0.5">Mit Bestellhistorie</div>
      </div>
    </div>

    <!-- Sort controls -->
    <div class="flex items-center gap-2 flex-wrap mb-6">
      <span class="text-xs font-semibold uppercase tracking-widest text-slate-600 mr-1">Sortieren</span>
      <button class="sort-btn active" data-sort="recent">🕐 Neueste</button>
      <button class="sort-btn" data-sort="best">⭐ Beste zuerst</button>
      <button class="sort-btn" data-sort="worst">👎 Schlechteste zuerst</button>
    </div>

    <!-- Review list (rendered by JS) -->
    <div id="review-list"></div>

  </main>

  <style>
    .sort-btn {
      padding: 0.375rem 0.875rem;
      border-radius: 999px;
      font-size: 0.875rem;
      font-weight: 500;
      border: 1px solid rgba(56,189,248,0.15);
      background: #121828;
      color: #94a3b8;
      cursor: pointer;
      transition: all 0.15s;
      font-family: inherit;
    }
    .sort-btn:hover {
      border-color: rgba(56,189,248,0.3);
      color: #e2e8f0;
    }
    .sort-btn.active {
      background: rgba(56,189,248,0.1);
      border-color: rgba(56,189,248,0.4);
      color: #38bdf8;
    }
  </style>

  <script type="application/json" id="reviews-data" set:html={reviewsJSON}></script>

  <script>
    const reviews = JSON.parse(document.getElementById('reviews-data').textContent);

    function getRatingInfo(rating) {
      if (rating === 4)  return { color: "#22c55e", bg: "rgba(34,197,94,0.12)",   label: "Top",      dots: 4, neg: false };
      if (rating === 3)  return { color: "#4ade80", bg: "rgba(74,222,128,0.10)",  label: "Gut",      dots: 3, neg: false };
      if (rating === 2)  return { color: "#86efac", bg: "rgba(134,239,172,0.08)", label: "OK",       dots: 2, neg: false };
      if (rating === 1)  return { color: "#bbf7d0", bg: "rgba(187,247,208,0.06)", label: "Meh",      dots: 1, neg: false };
      if (rating === 0)  return { color: "#94a3b8", bg: "rgba(148,163,184,0.06)", label: "–",        dots: 0, neg: false };
      if (rating === -1) return { color: "#fca5a5", bg: "rgba(252,165,165,0.08)", label: "Nein",     dots: 1, neg: true  };
      if (rating === -2) return { color: "#f87171", bg: "rgba(248,113,113,0.10)", label: "Schlecht", dots: 2, neg: true  };
      return                    { color: "#ef4444", bg: "rgba(239,68,68,0.12)",   label: "Avoid!",   dots: 4, neg: true  };
    }

    function fmtDate(iso) {
      const [year, month, day] = iso.split('-');
      const months = ['Jan','Feb','Mär','Apr','Mai','Jun','Jul','Aug','Sep','Okt','Nov','Dez'];
      return `${parseInt(day)}. ${months[parseInt(month)-1]} ${year}`;
    }

    function ratingBadge(rating) {
      const ri = getRatingInfo(rating);
      if (rating === 0) return `<span style="color:#475569;font-size:0.75rem;">–</span>`;
      let dots = '';
      for (let i = 0; i < ri.dots; i++) {
        dots += `<span style="width:6px;height:6px;border-radius:50%;background:${ri.color};display:inline-block;"></span>`;
      }
      if (!ri.neg) {
        for (let i = ri.dots; i < 4; i++) {
          dots += `<span style="width:6px;height:6px;border-radius:50%;border:1px solid ${ri.color};opacity:0.2;display:inline-block;"></span>`;
        }
      }
      return `
        <div style="display:inline-flex;align-items:center;gap:3px;padding:3px 10px;border-radius:999px;
                    background:${ri.bg};border:1px solid ${ri.color}40;">
          <span style="display:flex;align-items:center;gap:3px;">${dots}</span>
          <span style="font-size:0.68rem;font-weight:700;letter-spacing:0.04em;color:${ri.color};margin-left:3px;">${ri.label}</span>
        </div>`;
    }

    function reviewCard(r) {
      const hasOrders = !!r.lastOrderDate;
      const tag = hasOrders ? 'a' : 'div';
      const href = hasOrders ? ` href="/food/${r.slug}/"` : '';

      const dateStr = r.lastOrderDate
        ? `<span style="font-size:0.68rem;color:#38bdf8;opacity:0.75;">🛵 ${fmtDate(r.lastOrderDate)}</span>`
        : r.date
          ? `<span style="font-size:0.7rem;color:#475569;">${r.date}</span>`
          : '';

      const orderChip = hasOrders
        ? `<span style="font-size:0.62rem;font-weight:600;padding:2px 6px;border-radius:999px;
                        background:rgba(56,189,248,0.1);color:#38bdf8;border:1px solid rgba(56,189,248,0.25);">
             📦 Orders
           </span>`
        : '';

      return `
        <${tag}${href} class="review-card" style="
          display:grid;
          grid-template-columns:2.5rem 1fr auto;
          gap:0 0.875rem;
          padding:0.9rem 0.75rem;
          border-radius:12px;
          text-decoration:none;
          color:inherit;
          transition:background 0.15s;
          cursor:${hasOrders ? 'pointer' : 'default'};
          margin-bottom:2px;
        ">
          <div style="font-size:1.4rem;line-height:1;text-align:center;padding-top:2px;">${r.cuisine}</div>
          <div style="min-width:0;">
            <div style="font-size:0.95rem;font-weight:600;color:#f1f5f9;display:flex;align-items:center;gap:6px;flex-wrap:wrap;line-height:1.3;">
              ${r.name}
              ${orderChip}
            </div>
            ${r.notes ? `<div style="color:#64748b;font-size:0.8rem;margin-top:4px;line-height:1.5;">${r.notes}</div>` : ''}
          </div>
          <div style="display:flex;flex-direction:column;align-items:flex-end;gap:5px;padding-top:2px;">
            ${ratingBadge(r.rating)}
            ${dateStr}
          </div>
        </${tag}>`;
    }

    function yearSection(year, items) {
      return `
        <div style="margin-bottom:2.5rem;">
          <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:1rem;">
            <span style="font-size:0.7rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#38bdf8;opacity:0.6;">${year}</span>
            <span style="flex:1;height:1px;background:rgba(56,189,248,0.1);"></span>
          </div>
          ${items.map(reviewCard).join('')}
        </div>`;
    }

    function render(sort) {
      const list = document.getElementById('review-list');
      let sorted = [...reviews];

      if (sort === 'best') {
        sorted.sort((a, b) => b.rating - a.rating);
        list.innerHTML = `<div>${sorted.map(reviewCard).join('')}</div>`;
      } else if (sort === 'worst') {
        sorted.sort((a, b) => a.rating - b.rating);
        list.innerHTML = `<div>${sorted.map(reviewCard).join('')}</div>`;
      } else {
        sorted.sort((a, b) => b.sortKey.localeCompare(a.sortKey));
        const groups = [];
        for (const r of sorted) {
          const last = groups[groups.length - 1];
          if (last && last.year === r.displayYear) last.reviews.push(r);
          else groups.push({ year: r.displayYear, reviews: [r] });
        }
        list.innerHTML = groups.map(g => yearSection(g.year, g.reviews)).join('');
      }

      // hover effect for linked cards
      list.querySelectorAll('a.review-card').forEach(el => {
        el.addEventListener('mouseenter', () => {
          el.style.background = 'rgba(255,255,255,0.03)';
          el.querySelector('[style*="font-weight:600"]').style.color = '#38bdf8';
        });
        el.addEventListener('mouseleave', () => {
          el.style.background = '';
          el.querySelector('[style*="font-weight:600"]').style.color = '#f1f5f9';
        });
      });
    }

    render('recent');

    document.querySelectorAll('.sort-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.sort-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        render(btn.dataset.sort);
      });
    });
  </script>

</body>
</html>
