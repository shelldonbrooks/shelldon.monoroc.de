---
import ordersData from '../../data/orders.json';
import reviewsData from '../../data/reviews.json';

const title = "Food Reviews | Shelldon Brooks";
const description = "Ehrliche Reviews von Lieferanten und Restaurants in München.";

// ── Slug helper ──────────────────────────────────────────────────────────────
function toSlug(name: string): string {
  return name.toLowerCase()
    .replace(/⚠️|🚨/g, '')
    .trim()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
}

// ── Parse "25.2." style date strings into a sortable ISO key ─────────────────
function parseDateStr(date: string | undefined, year: number): string {
  if (!date) return `${year}-01-01`;
  const parts = date.replace(/\.$/, '').split('.');
  if (parts.length >= 2) {
    const day = parts[0].padStart(2, '0');
    const month = parts[1].padStart(2, '0');
    return `${year}-${month}-${day}`;
  }
  return `${year}-01-01`;
}

// ── Get most recent order date (ISO) for a slug ───────────────────────────────
function getLastOrderDate(slug: string): string | undefined {
  const restaurant = (ordersData as Record<string, { orders: { date: string }[] }>)[slug];
  if (!restaurant?.orders?.length) return undefined;
  return restaurant.orders.reduce(
    (latest, order) => (order.date > latest ? order.date : latest),
    restaurant.orders[0].date
  );
}

// ── Format ISO date for display ───────────────────────────────────────────────
function fmtDate(iso: string): string {
  const [year, month, day] = iso.split('-');
  const months = ['Jan','Feb','Mär','Apr','Mai','Jun','Jul','Aug','Sep','Okt','Nov','Dez'];
  return `${parseInt(day)}. ${months[parseInt(month)-1]} ${year}`;
}

// ── Rating helper ─────────────────────────────────────────────────────────────
function getRatingInfo(rating: number) {
  if (rating === 4)  return { color: "#22c55e", bg: "rgba(34,197,94,0.15)",    dots: 4, negative: false };
  if (rating === 3)  return { color: "#4ade80", bg: "rgba(74,222,128,0.12)",   dots: 3, negative: false };
  if (rating === 2)  return { color: "#86efac", bg: "rgba(134,239,172,0.10)",  dots: 2, negative: false };
  if (rating === 1)  return { color: "#bbf7d0", bg: "rgba(187,247,208,0.08)",  dots: 1, negative: false };
  if (rating === 0)  return { color: "#94a3b8", bg: "rgba(148,163,184,0.08)",  dots: 0, negative: false };
  if (rating === -1) return { color: "#fca5a5", bg: "rgba(252,165,165,0.10)",  dots: 1, negative: true  };
  if (rating === -2) return { color: "#f87171", bg: "rgba(248,113,113,0.12)",  dots: 2, negative: true  };
  return                    { color: "#ef4444", bg: "rgba(239,68,68,0.15)",    dots: 4, negative: true  };
}

// ── Build enriched flat list ──────────────────────────────────────────────────
type EnrichedReview = {
  name: string;
  cuisine: string;
  rating: number;
  notes?: string;
  date?: string;
  year: number;
  slug: string;
  lastOrderDate?: string;      // ISO date of most recent Wolt order
  sortKey: string;             // for sorting (most recent first)
  displayYear: number;         // year to group under in the UI
};

const allReviews: EnrichedReview[] = (reviewsData as { year: number; name: string; cuisine: string; rating: number; notes?: string; date?: string }[]).map(review => {
    const slug = toSlug(review.name);
    const lastOrderDate = getLastOrderDate(slug);
    const reviewDateISO = parseDateStr(review.date, review.year);
    const sortKey = lastOrderDate && lastOrderDate > reviewDateISO
      ? lastOrderDate
      : reviewDateISO;
    const displayYear = parseInt(sortKey.split('-')[0]);
    return { ...review, slug, lastOrderDate, sortKey, displayYear };
  });

// Sort newest first
allReviews.sort((a, b) => b.sortKey.localeCompare(a.sortKey));

// Group by displayYear for section headers
const yearGroups: { year: number; reviews: EnrichedReview[] }[] = [];
for (const review of allReviews) {
  const last = yearGroups[yearGroups.length - 1];
  if (last && last.year === review.displayYear) {
    last.reviews.push(review);
  } else {
    yearGroups.push({ year: review.displayYear, reviews: [review] });
  }
}

const totalReviews = allReviews.length;
const topCount    = allReviews.filter(r => r.rating >= 3).length;
const avoidCount  = allReviews.filter(r => r.rating < 0).length;
const orderCount  = Object.keys(ordersData).length;
---

<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    :root {
      --bg: #0b0f1a;
      --surface: #121828;
      --border: rgba(56, 189, 248, 0.12);
      --text: #e2e8f0;
      --muted: #64748b;
      --accent: #38bdf8;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      line-height: 1.5;
    }

    header {
      padding: 2rem 1.5rem 1.5rem;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      gap: 1.5rem;
      max-width: 780px;
      margin: 0 auto;
    }

    .back { color: var(--muted); text-decoration: none; font-size: 0.9rem; transition: color .2s; white-space: nowrap; }
    .back:hover { color: var(--accent); }

    .header-text h1 { font-size: 1.6rem; font-weight: 700; color: #fff; letter-spacing: -0.02em; }
    .header-text p  { color: var(--muted); font-size: 0.9rem; margin-top: 0.2rem; }

    main { max-width: 780px; margin: 0 auto; padding: 2.5rem 1.5rem 5rem; }

    /* Stats */
    .stats {
      display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 2.5rem;
      padding: 1rem 1.25rem; background: var(--surface);
      border: 1px solid var(--border); border-radius: 10px;
    }
    .stat { display: flex; align-items: center; gap: 0.4rem; font-size: 0.8rem; color: var(--muted); }
    .stat strong { color: var(--text); }

    /* Year sections */
    .year-section { margin-bottom: 3rem; }
    .year-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.25rem; }
    .year-label { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); opacity: 0.7; }
    .year-line { flex: 1; height: 1px; background: var(--border); }

    /* Review rows */
    .review {
      display: grid;
      grid-template-columns: 2rem 1fr auto;
      gap: 0 1rem;
      padding: 0.85rem 0;
      border-bottom: 1px solid rgba(255,255,255,0.04);
      align-items: start;
      border-radius: 4px;
      text-decoration: none;
      color: inherit;
      transition: background .15s;
    }
    .review:last-child { border-bottom: none; }
    .review:hover { background: rgba(255,255,255,0.02); }
    a.review:hover .review-name { color: var(--accent); }

    .review-emoji { font-size: 1.2rem; line-height: 1.4; text-align: center; }
    .review-body  { min-width: 0; }

    .review-name {
      font-size: 1rem; font-weight: 600; color: #fff; line-height: 1.3;
      display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap;
      transition: color .15s;
    }

    .order-chip {
      font-size: 0.65rem; font-weight: 600; padding: 0.1rem 0.4rem;
      border-radius: 999px; background: rgba(56,189,248,0.12); color: var(--accent);
      border: 1px solid rgba(56,189,248,0.25); letter-spacing: 0.03em; white-space: nowrap;
    }

    .review-notes { color: var(--muted); font-size: 0.82rem; margin-top: 0.3rem; line-height: 1.5; }

    /* Right column */
    .review-meta { display: flex; flex-direction: column; align-items: flex-end; gap: 0.3rem; padding-top: 0.1rem; }

    .rating-badge {
      display: flex; align-items: center; gap: 3px; padding: 0.2rem 0.55rem;
      border-radius: 999px; font-size: 0.7rem; font-weight: 700;
      letter-spacing: 0.04em; white-space: nowrap; border: 1px solid currentColor;
    }
    .rating-dots { display: flex; gap: 3px; align-items: center; }
    .dot       { width: 7px; height: 7px; border-radius: 50%; display: inline-block; }
    .dot-empty { width: 7px; height: 7px; border-radius: 50%; border: 1px solid; display: inline-block; opacity: 0.25; }

    .review-date    { font-size: 0.72rem; color: var(--muted); opacity: 0.6; }
    .last-order-tag { font-size: 0.68rem; color: var(--accent); opacity: 0.75; white-space: nowrap; }

    @media (max-width: 520px) {
      .review { grid-template-columns: 1.6rem 1fr; }
      .review-meta { display: none; }
    }
  </style>
</head>
<body>

<header>
  <a href="/" class="back">← Home</a>
  <div class="header-text">
    <h1>🍽️ Food Reviews</h1>
    <p>Ehrliche Reviews aus München – Lieferung & Restaurant</p>
  </div>
</header>

<main>

  <div class="stats">
    <div class="stat"><strong>{totalReviews}</strong> Reviews</div>
    <div class="stat">✅ <strong>{topCount}</strong> empfehlenswert</div>
    <div class="stat">❌ <strong>{avoidCount}</strong> eher nein</div>
    <div class="stat">📦 <strong>{orderCount}</strong> mit Bestellhistorie</div>
  </div>

  {yearGroups.map(group => (
    <div class="year-section">
      <div class="year-header">
        <span class="year-label">{group.year}</span>
        <span class="year-line" />
      </div>

      {group.reviews.map(review => {
        const ri = getRatingInfo(review.rating);
        const hasOrderHistory = !!review.lastOrderDate;
        const Tag = hasOrderHistory ? 'a' : 'div';
        const linkProps = hasOrderHistory ? { href: `/food/${review.slug}/` } : {};

        return (
          <Tag class="review" {...linkProps}>
            <span class="review-emoji">{review.cuisine}</span>

            <div class="review-body">
              <div class="review-name">
                {review.name}
                {hasOrderHistory && <span class="order-chip">📦 Orders</span>}
              </div>
              {review.notes && (
                <div class="review-notes">{review.notes}</div>
              )}
            </div>

            <div class="review-meta">
              {review.rating !== 0 ? (
                <div
                  class="rating-badge"
                  style={`color:${ri.color}; background:${ri.bg}; border-color:${ri.color}40;`}
                >
                  <span class="rating-dots">
                    {Array.from({ length: ri.dots }, (_, i) => (
                      <span class="dot" style={`background:${ri.color}`} />
                    ))}
                    {!ri.negative && Array.from({ length: 4 - ri.dots }, (_, i) => (
                      <span class="dot-empty" style={`border-color:${ri.color}`} />
                    ))}
                  </span>
                </div>
              ) : (
                <span style="color: #94a3b8; font-size: 0.75rem;">–</span>
              )}
              {review.lastOrderDate
                ? <span class="last-order-tag">🛵 {fmtDate(review.lastOrderDate)}</span>
                : review.date
                  ? <span class="review-date">{review.date}</span>
                  : null
              }
            </div>
          </Tag>
        );
      })}
    </div>
  ))}

</main>

</body>
</html>
