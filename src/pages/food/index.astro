---
import ordersData from '../../data/orders.json';

const title = "Food Reviews | Shelldon Brooks";
const description = "Ehrliche Reviews von Lieferanten und Restaurants in München.";

// ── Slug helper ──────────────────────────────────────────────────────────────
function toSlug(name: string): string {
  return name.toLowerCase()
    .replace(/⚠️|🚨/g, '')
    .trim()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
}

// ── Parse "25.2." style date strings into a sortable ISO key ─────────────────
function parseDateStr(date: string | undefined, year: number): string {
  if (!date) return `${year}-01-01`;
  const parts = date.replace(/\.$/, '').split('.');
  if (parts.length >= 2) {
    const day = parts[0].padStart(2, '0');
    const month = parts[1].padStart(2, '0');
    return `${year}-${month}-${day}`;
  }
  return `${year}-01-01`;
}

// ── Get most recent order date (ISO) for a slug ───────────────────────────────
function getLastOrderDate(slug: string): string | undefined {
  const restaurant = (ordersData as Record<string, { orders: { date: string }[] }>)[slug];
  if (!restaurant?.orders?.length) return undefined;
  return restaurant.orders.reduce(
    (latest, order) => (order.date > latest ? order.date : latest),
    restaurant.orders[0].date
  );
}

// ── Format ISO date for display ───────────────────────────────────────────────
function fmtDate(iso: string): string {
  const [year, month, day] = iso.split('-');
  const months = ['Jan','Feb','Mär','Apr','Mai','Jun','Jul','Aug','Sep','Okt','Nov','Dez'];
  return `${parseInt(day)}. ${months[parseInt(month)-1]} ${year}`;
}

// ── Rating helper ─────────────────────────────────────────────────────────────
function getRatingInfo(rating: number) {
  if (rating === 4)  return { color: "#22c55e", bg: "rgba(34,197,94,0.15)",    dots: 4, negative: false };
  if (rating === 3)  return { color: "#4ade80", bg: "rgba(74,222,128,0.12)",   dots: 3, negative: false };
  if (rating === 2)  return { color: "#86efac", bg: "rgba(134,239,172,0.10)",  dots: 2, negative: false };
  if (rating === 1)  return { color: "#bbf7d0", bg: "rgba(187,247,208,0.08)",  dots: 1, negative: false };
  if (rating === 0)  return { color: "#94a3b8", bg: "rgba(148,163,184,0.08)",  dots: 0, negative: false };
  if (rating === -1) return { color: "#fca5a5", bg: "rgba(252,165,165,0.10)",  dots: 1, negative: true  };
  if (rating === -2) return { color: "#f87171", bg: "rgba(248,113,113,0.12)",  dots: 2, negative: true  };
  return                    { color: "#ef4444", bg: "rgba(239,68,68,0.15)",    dots: 4, negative: true  };
}

