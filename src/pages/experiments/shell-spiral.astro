---
import ShellCanvas from '../../components/ShellCanvas.astro';
---

<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shell Spiral - Shelldon Brooks</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      overflow: hidden;
    }
    
    .overlay {
      position: fixed;
      top: 20px;
      left: 20px;
      right: 20px;
      z-index: 10;
      pointer-events: none;
    }
    
    .info-card {
      background: rgba(15, 23, 42, 0.9);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(56, 189, 248, 0.3);
      border-radius: 12px;
      padding: 1.5rem;
      color: #e2e8f0;
      max-width: 400px;
      pointer-events: auto;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
    }
    
    .info-card h1 {
      color: #38bdf8;
      font-size: 1.5rem;
      margin-bottom: 0.5rem;
    }
    
    .info-card p {
      color: #94a3b8;
      margin-bottom: 1rem;
      line-height: 1.6;
    }
    
    .back-btn {
      display: inline-block;
      padding: 0.5rem 1rem;
      background: rgba(56, 189, 248, 0.2);
      border: 1px solid #38bdf8;
      color: #38bdf8;
      text-decoration: none;
      border-radius: 6px;
      transition: all 0.2s;
      font-weight: 500;
    }
    
    .back-btn:hover {
      background: rgba(56, 189, 248, 0.3);
      transform: translateY(-2px);
    }
    
    .controls {
      background: rgba(15, 23, 42, 0.9);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(56, 189, 248, 0.3);
      border-radius: 12px;
      padding: 1rem;
      margin-top: 1rem;
    }
    
    .controls h3 {
      color: #38bdf8;
      font-size: 1rem;
      margin-bottom: 0.75rem;
    }
    
    .control-item {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 0.5rem;
      color: #94a3b8;
      font-size: 0.9rem;
    }
    
    .key {
      background: rgba(56, 189, 248, 0.2);
      padding: 0.25rem 0.5rem;
      border-radius: 4px;
      font-family: monospace;
      color: #38bdf8;
    }
  </style>
</head>
<body>
  <ShellCanvas />
  
  <div class="overlay">
    <div class="info-card">
      <h1>🐚 Shell Spiral</h1>
      <p>
        3000 particles arranged in a golden ratio Fibonacci spiral.
        The camera follows your mouse movement for an immersive 3D experience.
      </p>
      
      <div class="controls">
        <h3>✨ Features</h3>
        <div class="control-item">
          <span>🖱️</span>
          <span>Move mouse to control camera</span>
        </div>
        <div class="control-item">
          <span>🌀</span>
          <span>Continuous 3D rotation</span>
        </div>
        <div class="control-item">
          <span>💫</span>
          <span>Breathing pulse animation</span>
        </div>
        <div class="control-item">
          <span>🎨</span>
          <span>Cyan to blue color gradient</span>
        </div>
      </div>
      
      <a href="/" class="back-btn">← Back to Home</a>
    </div>
  </div>
</body>
</html>
