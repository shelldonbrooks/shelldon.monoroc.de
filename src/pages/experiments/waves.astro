---
// Wave Simulation - Interactive ocean waves with three.js
---

<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Wave Simulation - Shelldon Brooks</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      overflow: hidden;
      background: #001a33;
    }
    #canvas-container {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
    }
    .bottom-bar {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 10;
      background: rgba(0, 26, 51, 0.95);
      backdrop-filter: blur(20px);
      border-top: 1px solid rgba(56, 189, 248, 0.3);
      padding: 0.75rem 1rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .title {
      color: #38bdf8;
      font-size: 1rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .controls {
      display: flex;
      gap: 1rem;
      align-items: center;
      flex-wrap: wrap;
    }
    .control-group {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }
    .control-label {
      font-size: 0.75rem;
      color: #94a3b8;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .slider {
      width: 120px;
      height: 4px;
      appearance: none;
      background: rgba(56, 189, 248, 0.2);
      border-radius: 2px;
      outline: none;
    }
    .slider::-webkit-slider-thumb {
      appearance: none;
      width: 16px;
      height: 16px;
      background: #38bdf8;
      border-radius: 50%;
      cursor: pointer;
      box-shadow: 0 0 8px rgba(56, 189, 248, 0.5);
    }
    .slider::-moz-range-thumb {
      width: 16px;
      height: 16px;
      background: #38bdf8;
      border-radius: 50%;
      cursor: pointer;
      border: none;
      box-shadow: 0 0 8px rgba(56, 189, 248, 0.5);
    }
    .button {
      padding: 0.4rem 0.8rem;
      background: rgba(56, 189, 248, 0.1);
      border: 1px solid rgba(56, 189, 248, 0.3);
      color: #38bdf8;
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.2s;
      font-size: 0.85rem;
      font-weight: 500;
    }
    .button:hover {
      background: rgba(56, 189, 248, 0.2);
    }
    .back-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 1rem;
      background: rgba(56, 189, 248, 0.1);
      border: 1px solid rgba(56, 189, 248, 0.3);
      color: #38bdf8;
      text-decoration: none;
      border-radius: 6px;
      transition: all 0.2s;
      font-weight: 500;
      font-size: 0.9rem;
    }
    .back-btn:hover {
      background: rgba(56, 189, 248, 0.2);
      transform: translateY(-2px);
    }
    @media (max-width: 768px) {
      .controls {
        width: 100%;
        justify-content: space-between;
      }
      .slider {
        width: 80px;
      }
    }
  </style>
</head>
<body>
  <div id="canvas-container"></div>

  <div class="bottom-bar">
    <div class="title">🌊 Wave Simulation</div>
    <div class="controls">
      <div class="control-group">
        <label class="control-label">Wave Height</label>
        <input type="range" class="slider" id="height-slider" min="0.1" max="2" step="0.1" value="0.5">
      </div>
      <div class="control-group">
        <label class="control-label">Speed</label>
        <input type="range" class="slider" id="speed-slider" min="0.5" max="3" step="0.1" value="1">
      </div>
      <div class="control-group">
        <label class="control-label">Frequency</label>
        <input type="range" class="slider" id="freq-slider" min="1" max="5" step="0.5" value="2">
      </div>
      <button class="button" id="reset-btn">Reset</button>
    </div>
    <a href="/" class="back-btn">← Home</a>
  </div>

  <script type="module">
    import * as THREE from 'https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js';
    import { OrbitControls } from 'https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/controls/OrbitControls.js';

    // Scene setup
    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x001a33);
    scene.fog = new THREE.Fog(0x001a33, 10, 50);

    const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 100);
    camera.position.set(0, 5, 8);

    const renderer = new THREE.WebGLRenderer({ antialias: true });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    document.getElementById('canvas-container').appendChild(renderer.domElement);

    // Controls
    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.dampingFactor = 0.05;
    controls.minDistance = 3;
    controls.maxDistance = 30;
    controls.maxPolarAngle = Math.PI / 2.1;

    // Lighting
    const ambientLight = new THREE.AmbientLight(0x38bdf8, 0.3);
    scene.add(ambientLight);

    const directionalLight = new THREE.DirectionalLight(0xffffff, 0.8);
    directionalLight.position.set(5, 10, 5);
    scene.add(directionalLight);

    const pointLight = new THREE.PointLight(0x38bdf8, 1, 30);
    pointLight.position.set(0, 3, 0);
    scene.add(pointLight);

    // Wave parameters
    let params = {
      waveHeight: 0.5,
      waveSpeed: 1,
      waveFrequency: 2
    };

    // Create ocean mesh
    const oceanGeometry = new THREE.PlaneGeometry(30, 30, 128, 128);
    const oceanMaterial = new THREE.MeshPhongMaterial({
      color: 0x0ea5e9,
      transparent: true,
      opacity: 0.8,
      shininess: 100,
      specular: 0x38bdf8,
      side: THREE.DoubleSide,
      flatShading: false,
      wireframe: false
    });

    const ocean = new THREE.Mesh(oceanGeometry, oceanMaterial);
    ocean.rotation.x = -Math.PI / 2;
    scene.add(ocean);

    // Store original positions
    const positionAttribute = oceanGeometry.getAttribute('position');
    const originalPositions = new Float32Array(positionAttribute.count * 3);
    for (let i = 0; i < positionAttribute.count; i++) {
      originalPositions[i * 3] = positionAttribute.getX(i);
      originalPositions[i * 3 + 1] = positionAttribute.getY(i);
      originalPositions[i * 3 + 2] = positionAttribute.getZ(i);
    }

    // Add wireframe overlay for better visualization
    const wireframeGeometry = new THREE.WireframeGeometry(oceanGeometry);
    const wireframeMaterial = new THREE.LineBasicMaterial({ 
      color: 0x38bdf8, 
      transparent: true, 
      opacity: 0.1 
    });
    const wireframe = new THREE.LineSegments(wireframeGeometry, wireframeMaterial);
    ocean.add(wireframe);

    // Controls
    document.getElementById('height-slider').addEventListener('input', (e) => {
      params.waveHeight = parseFloat(e.target.value);
    });

    document.getElementById('speed-slider').addEventListener('input', (e) => {
      params.waveSpeed = parseFloat(e.target.value);
    });

    document.getElementById('freq-slider').addEventListener('input', (e) => {
      params.waveFrequency = parseFloat(e.target.value);
    });

    document.getElementById('reset-btn').addEventListener('click', () => {
      params.waveHeight = 0.5;
      params.waveSpeed = 1;
      params.waveFrequency = 2;
      document.getElementById('height-slider').value = 0.5;
      document.getElementById('speed-slider').value = 1;
      document.getElementById('freq-slider').value = 2;
    });

    // Animation
    let time = 0;

    function animate() {
      requestAnimationFrame(animate);
      
      time += 0.01 * params.waveSpeed;
      
      // Update wave vertices
      for (let i = 0; i < positionAttribute.count; i++) {
        const x = originalPositions[i * 3];
        const y = originalPositions[i * 3 + 1];
        
        // Multiple wave patterns
        const wave1 = Math.sin(x * params.waveFrequency * 0.2 + time) * params.waveHeight;
        const wave2 = Math.sin(y * params.waveFrequency * 0.3 + time * 1.3) * params.waveHeight * 0.5;
        const wave3 = Math.sin((x + y) * params.waveFrequency * 0.15 + time * 0.7) * params.waveHeight * 0.3;
        
        const z = wave1 + wave2 + wave3;
        
        positionAttribute.setZ(i, z);
      }
      
      positionAttribute.needsUpdate = true;
      oceanGeometry.computeVertexNormals();
      
      // Update wireframe
      wireframe.geometry.dispose();
      wireframe.geometry = new THREE.WireframeGeometry(oceanGeometry);
      
      // Animate light
      pointLight.position.x = Math.sin(time * 0.5) * 5;
      pointLight.position.z = Math.cos(time * 0.5) * 5;
      
      controls.update();
      renderer.render(scene, camera);
    }

    animate();

    // Resize
    window.addEventListener('resize', () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    });
  </script>
</body>
</html>
