---
// DNA Helix - Animated 3D double helix
---

<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DNA Helix - Shelldon Brooks</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      overflow: hidden;
      background: #000;
    }
    #canvas-container {
      position: fixed;
      top: 0; left: 0;
      width: 100%; height: 100%;
    }
    .bottom-bar {
      position: fixed;
      bottom: 0; left: 0; right: 0;
      z-index: 10;
      background: rgba(0, 0, 0, 0.85);
      backdrop-filter: blur(20px);
      border-top: 1px solid rgba(255, 255, 255, 0.15);
      padding: 0.75rem 1rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }
    .title {
      color: #fff;
      font-size: 1rem;
      font-weight: 600;
    }
    .subtitle {
      color: #4ee8d0;
      font-size: 0.8rem;
      margin-top: 0.15rem;
    }
    .back-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 1rem;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.2);
      color: #fff;
      text-decoration: none;
      border-radius: 6px;
      transition: all 0.2s;
      font-weight: 500;
      font-size: 0.9rem;
      white-space: nowrap;
    }
    .back-btn:hover {
      background: rgba(255, 255, 255, 0.18);
      transform: translateY(-2px);
    }
  </style>
</head>
<body>
  <div id="canvas-container"></div>

  <div class="bottom-bar">
    <div>
      <div class="title">🧬 DNA Helix</div>
      <div class="subtitle">Drag to rotate · Scroll to zoom</div>
    </div>
    <a href="/" class="back-btn">← Home</a>
  </div>

  <script type="importmap">
  {
    "imports": {
      "three": "https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js",
      "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/"
    }
  }
  </script>
  <script type="module" is:inline>
    import * as THREE from 'three';
    import { OrbitControls } from 'three/addons/controls/OrbitControls.js';

    const scene = new THREE.Scene();
    scene.fog = new THREE.FogExp2(0x000000, 0.03);

    const camera = new THREE.PerspectiveCamera(55, window.innerWidth / window.innerHeight, 0.1, 200);
    camera.position.set(6, 0, 12);

    const renderer = new THREE.WebGLRenderer({ antialias: true });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    document.getElementById('canvas-container').appendChild(renderer.domElement);

    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.dampingFactor = 0.05;
    controls.autoRotate = true;
    controls.autoRotateSpeed = 0.4;
    controls.minDistance = 3;
    controls.maxDistance = 30;

    // Base pair colors: A-T orange/yellow, G-C green/magenta
    const BASE_COLORS = [
      new THREE.Color(1.0, 0.55, 0.0),  // A - orange
      new THREE.Color(1.0, 0.9,  0.1),  // T - yellow
      new THREE.Color(0.1, 1.0,  0.4),  // G - green
      new THREE.Color(1.0, 0.0,  0.8),  // C - magenta
    ];
    const STRAND_COLOR = new THREE.Color(0.1, 0.8, 1.0); // cyan phosphate backbone

    const TURNS     = 6;       // number of full helix turns
    const HEIGHT    = 20;      // total height
    const RADIUS    = 2.0;     // helix radius
    const STEPS_PER_TURN = 24; // resolution
    const TOTAL_STEPS = TURNS * STEPS_PER_TURN;

    const strandSpheres = [];  // for pulsing

    // Build a smooth tube for each backbone strand
    function makeStrandCurve(strandOffset) {
      const points = [];
      for (let i = 0; i <= TOTAL_STEPS; i++) {
        const t     = i / TOTAL_STEPS;
        const angle = t * TURNS * Math.PI * 2 + strandOffset;
        const y     = (t - 0.5) * HEIGHT;
        points.push(new THREE.Vector3(
          Math.cos(angle) * RADIUS,
          y,
          Math.sin(angle) * RADIUS
        ));
      }
      return new THREE.CatmullRomCurve3(points);
    }

    const curve1 = makeStrandCurve(0);
    const curve2 = makeStrandCurve(Math.PI);

    [curve1, curve2].forEach(curve => {
      const tubeGeo = new THREE.TubeGeometry(curve, TOTAL_STEPS * 2, 0.06, 6, false);
      const tubeMat = new THREE.MeshBasicMaterial({
        color: STRAND_COLOR,
        transparent: true,
        opacity: 0.7,
        blending: THREE.AdditiveBlending,
      });
      scene.add(new THREE.Mesh(tubeGeo, tubeMat));
    });

    // Backbone spheres (nodes on each strand)
    const nodeGeo = new THREE.SphereGeometry(0.12, 8, 8);
    for (let i = 0; i <= TOTAL_STEPS; i++) {
      const t = i / TOTAL_STEPS;
      [0, Math.PI].forEach(offset => {
        const angle = t * TURNS * Math.PI * 2 + offset;
        const y     = (t - 0.5) * HEIGHT;
        const sphere = new THREE.Mesh(nodeGeo, new THREE.MeshBasicMaterial({
          color: STRAND_COLOR,
          transparent: true,
          opacity: 0.9,
          blending: THREE.AdditiveBlending,
        }));
        sphere.position.set(Math.cos(angle) * RADIUS, y, Math.sin(angle) * RADIUS);
        sphere.userData.phase = Math.random() * Math.PI * 2;
        scene.add(sphere);
        strandSpheres.push(sphere);
      });
    }

    // Base pairs (rungs connecting the two strands)
    const basePairs = [];
    const basePairInterval = 2; // every N steps
    for (let i = 0; i <= TOTAL_STEPS; i += basePairInterval) {
      const t     = i / TOTAL_STEPS;
      const angle = t * TURNS * Math.PI * 2;
      const y     = (t - 0.5) * HEIGHT;

      const x1 = Math.cos(angle) * RADIUS;
      const z1 = Math.sin(angle) * RADIUS;
      const x2 = Math.cos(angle + Math.PI) * RADIUS;
      const z2 = Math.sin(angle + Math.PI) * RADIUS;

      // Rung cylinder
      const dx = x2 - x1, dz = z2 - z1;
      const len = Math.sqrt(dx * dx + dz * dz);
      const rungGeo = new THREE.CylinderGeometry(0.04, 0.04, len, 6, 1);
      const pairIdx = Math.floor(Math.random() * 2); // 0=AT, 1=GC
      const rungMat = new THREE.MeshBasicMaterial({
        color: BASE_COLORS[pairIdx * 2],
        transparent: true,
        opacity: 0.6,
        blending: THREE.AdditiveBlending,
      });
      const rung = new THREE.Mesh(rungGeo, rungMat);
      rung.position.set((x1 + x2) / 2, y, (z1 + z2) / 2);
      rung.rotation.z = Math.PI / 2;
      rung.lookAt(new THREE.Vector3(x2, y, z2));
      rung.rotateX(Math.PI / 2);
      scene.add(rung);

      // Two base spheres at ends
      [
        { pos: new THREE.Vector3(x1, y, z1), color: BASE_COLORS[pairIdx * 2] },
        { pos: new THREE.Vector3(x2, y, z2), color: BASE_COLORS[pairIdx * 2 + 1] },
      ].forEach(({ pos, color }) => {
        const bGeo = new THREE.SphereGeometry(0.18, 10, 10);
        const bMat = new THREE.MeshBasicMaterial({
          color,
          transparent: true,
          opacity: 0.95,
          blending: THREE.AdditiveBlending,
        });
        const bs = new THREE.Mesh(bGeo, bMat);
        bs.position.copy(pos);
        bs.userData.phase  = Math.random() * Math.PI * 2;
        bs.userData.baseColor = color.clone();
        scene.add(bs);
        basePairs.push(bs);
      });
    }

    // Camera travel parameters
    let cameraTravelDir = 1;
    let cameraY = 0;
    const TRAVEL_SPEED = 0.015;
    const TRAVEL_LIMIT = HEIGHT / 2 - 1;

    const clock = new THREE.Clock();

    function animate() {
      requestAnimationFrame(animate);
      const t = clock.getElapsedTime();

      // Pulsing: base spheres breathe
      basePairs.forEach(bp => {
        const pulse = 1.0 + 0.2 * Math.sin(t * 2.5 + bp.userData.phase);
        bp.scale.setScalar(pulse);
        const br = 0.7 + 0.3 * Math.sin(t * 2.5 + bp.userData.phase);
        bp.material.opacity = 0.6 + 0.35 * br;
      });

      // Strand spheres glow
      strandSpheres.forEach(sp => {
        const pulse = 1.0 + 0.15 * Math.sin(t * 3.0 + sp.userData.phase);
        sp.scale.setScalar(pulse);
      });

      // Camera slowly travels up/down the helix
      cameraY += TRAVEL_SPEED * cameraTravelDir;
      if (cameraY >  TRAVEL_LIMIT) cameraTravelDir = -1;
      if (cameraY < -TRAVEL_LIMIT) cameraTravelDir =  1;
      controls.target.y += (cameraY - controls.target.y) * 0.02;

      controls.update();
      renderer.render(scene, camera);
    }

    animate();

    window.addEventListener('resize', () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    });
  </script>
</body>
</html>
