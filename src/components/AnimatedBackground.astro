---
// Animated Background - Alternates between Galaxy and DNA Helix animations
---

<canvas id="animated-canvas"></canvas>

<script type="module">
  import * as THREE from 'https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js';
  
  const canvas = document.getElementById('animated-canvas');
  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
  const renderer = new THREE.WebGLRenderer({ 
    canvas, 
    alpha: false,
    antialias: true 
  });
  
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  
  // Animation state
  let currentMode = 'galaxy';
  let switchInterval = 18000; // 18 seconds per mode
  let lastSwitch = Date.now();
  let modeAlpha = 1.0; // for fade
  let fadingOut = false;
  let fadeTarget = 'dna';

  // ── Galaxy ──────────────────────────────────────────────────
  let galaxyPoints = null;
  let galaxyGeometry = null;
  let galaxyMaterial = null;

  function createGalaxy() {
    if (galaxyPoints) {
      scene.remove(galaxyPoints);
      if (galaxyGeometry) galaxyGeometry.dispose();
      if (galaxyMaterial) galaxyMaterial.dispose();
    }
    const params = {
      count: 20000, size: 0.02, radius: 5, branches: 5,
      spin: 1, randomness: 0.2, randomnessPower: 3,
      insideColor: '#ff6030', outsideColor: '#1b3984'
    };
    galaxyGeometry = new THREE.BufferGeometry();
    const positions = new Float32Array(params.count * 3);
    const colors    = new Float32Array(params.count * 3);
    const colorInside  = new THREE.Color(params.insideColor);
    const colorOutside = new THREE.Color(params.outsideColor);
    for (let i = 0; i < params.count; i++) {
      const i3 = i * 3;
      const radius     = Math.random() * params.radius;
      const spinAngle  = radius * params.spin;
      const branchAngle = (i % params.branches) / params.branches * Math.PI * 2;
      const rx = Math.pow(Math.random(), params.randomnessPower) * (Math.random() < 0.5 ? 1 : -1) * params.randomness * radius;
      const ry = Math.pow(Math.random(), params.randomnessPower) * (Math.random() < 0.5 ? 1 : -1) * params.randomness * radius;
      const rz = Math.pow(Math.random(), params.randomnessPower) * (Math.random() < 0.5 ? 1 : -1) * params.randomness * radius;
      positions[i3]     = Math.cos(branchAngle + spinAngle) * radius + rx;
      positions[i3 + 1] = ry;
      positions[i3 + 2] = Math.sin(branchAngle + spinAngle) * radius + rz;
      const mc = colorInside.clone().lerp(colorOutside, radius / params.radius);
      colors[i3] = mc.r; colors[i3 + 1] = mc.g; colors[i3 + 2] = mc.b;
    }
    galaxyGeometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    galaxyGeometry.setAttribute('color',    new THREE.BufferAttribute(colors, 3));
    galaxyMaterial = new THREE.PointsMaterial({
      size: params.size, sizeAttenuation: true, depthWrite: false,
      blending: THREE.AdditiveBlending, vertexColors: true
    });
    galaxyPoints = new THREE.Points(galaxyGeometry, galaxyMaterial);
    galaxyPoints.visible = currentMode === 'galaxy';
    scene.add(galaxyPoints);
  }

  // ── DNA Helix ────────────────────────────────────────────────
  const dnaGroup = new THREE.Group();
  scene.add(dnaGroup);
  dnaGroup.visible = false;

  const BASE_COLORS = [
    new THREE.Color(1.0, 0.55, 0.0),
    new THREE.Color(1.0, 0.90, 0.1),
    new THREE.Color(0.1, 1.0,  0.4),
    new THREE.Color(1.0, 0.0,  0.8),
  ];
  const STRAND_COLOR = new THREE.Color(0.1, 0.8, 1.0);

  const TURNS = 5, HEIGHT = 16, RADIUS = 1.8, STEPS_PER_TURN = 20;
  const TOTAL_STEPS = TURNS * STEPS_PER_TURN;

  const dnaPulseObjects = []; // { mesh, phase }

  function buildDNA() {
    function makeStrandCurve(offset) {
      const pts = [];
      for (let i = 0; i <= TOTAL_STEPS; i++) {
        const t = i / TOTAL_STEPS;
        const a = t * TURNS * Math.PI * 2 + offset;
        pts.push(new THREE.Vector3(Math.cos(a) * RADIUS, (t - 0.5) * HEIGHT, Math.sin(a) * RADIUS));
      }
      return new THREE.CatmullRomCurve3(pts);
    }
    [0, Math.PI].forEach(offset => {
      const curve   = makeStrandCurve(offset);
      const tubeGeo = new THREE.TubeGeometry(curve, TOTAL_STEPS * 2, 0.05, 6, false);
      const tubeMat = new THREE.MeshBasicMaterial({
        color: STRAND_COLOR, transparent: true, opacity: 0.6, blending: THREE.AdditiveBlending
      });
      dnaGroup.add(new THREE.Mesh(tubeGeo, tubeMat));
    });

    const nodeGeo = new THREE.SphereGeometry(0.10, 7, 7);
    for (let i = 0; i <= TOTAL_STEPS; i++) {
      const t = i / TOTAL_STEPS;
      [0, Math.PI].forEach(offset => {
        const a = t * TURNS * Math.PI * 2 + offset;
        const y = (t - 0.5) * HEIGHT;
        const m = new THREE.MeshBasicMaterial({ color: STRAND_COLOR, transparent: true, opacity: 0.85, blending: THREE.AdditiveBlending });
        const s = new THREE.Mesh(nodeGeo, m);
        s.position.set(Math.cos(a) * RADIUS, y, Math.sin(a) * RADIUS);
        s.userData.phase = Math.random() * Math.PI * 2;
        dnaGroup.add(s);
        dnaPulseObjects.push(s);
      });
    }

    const bpInterval = 2;
    for (let i = 0; i <= TOTAL_STEPS; i += bpInterval) {
      const t  = i / TOTAL_STEPS;
      const a  = t * TURNS * Math.PI * 2;
      const y  = (t - 0.5) * HEIGHT;
      const x1 = Math.cos(a) * RADIUS,       z1 = Math.sin(a) * RADIUS;
      const x2 = Math.cos(a + Math.PI) * RADIUS, z2 = Math.sin(a + Math.PI) * RADIUS;
      const len = Math.sqrt((x2-x1)**2 + (z2-z1)**2);

      const pairIdx = Math.floor(Math.random() * 2);
      const rungGeo = new THREE.CylinderGeometry(0.035, 0.035, len, 5, 1);
      const rungMat = new THREE.MeshBasicMaterial({ color: BASE_COLORS[pairIdx*2], transparent: true, opacity: 0.5, blending: THREE.AdditiveBlending });
      const rung = new THREE.Mesh(rungGeo, rungMat);
      rung.position.set((x1+x2)/2, y, (z1+z2)/2);
      rung.lookAt(new THREE.Vector3(x2, y, z2));
      rung.rotateX(Math.PI / 2);
      dnaGroup.add(rung);

      [
        { pos: new THREE.Vector3(x1, y, z1), color: BASE_COLORS[pairIdx*2] },
        { pos: new THREE.Vector3(x2, y, z2), color: BASE_COLORS[pairIdx*2+1] },
      ].forEach(({ pos, color }) => {
        const bm = new THREE.MeshBasicMaterial({ color, transparent: true, opacity: 0.9, blending: THREE.AdditiveBlending });
        const bs = new THREE.Mesh(new THREE.SphereGeometry(0.15, 8, 8), bm);
        bs.position.copy(pos);
        bs.userData.phase = Math.random() * Math.PI * 2;
        dnaGroup.add(bs);
        dnaPulseObjects.push(bs);
      });
    }
  }

  createGalaxy();
  buildDNA();

  // ── Camera state ─────────────────────────────────────────────
  // Galaxy camera
  camera.position.set(4, 3, 4);
  scene.background = new THREE.Color(0x000000);

  // DNA camera animation state
  let dnaAngle   = 0;    // horizontal orbit angle
  let dnaTargetY = 0;    // vertical travel
  let dnaTravelDir = 1;
  const DNA_ORBIT_RADIUS = 10;
  const DNA_ORBIT_SPEED  = 0.004;  // gentle orbit
  const DNA_TRAVEL_SPEED = 0.012;
  const DNA_TRAVEL_LIMIT = HEIGHT / 2 - 1.5;
  const DNA_WOBBLE_AMP   = 0.6;    // slight lateral drift

  // ── Mode switching ───────────────────────────────────────────
  function switchMode() {
    currentMode = currentMode === 'galaxy' ? 'dna' : 'galaxy';
    if (galaxyPoints) galaxyPoints.visible = currentMode === 'galaxy';
    dnaGroup.visible = currentMode === 'dna';

    if (currentMode === 'galaxy') {
      scene.background = new THREE.Color(0x000000);
      scene.fog = null;
      camera.position.set(4, 3, 4);
    } else {
      scene.background = new THREE.Color(0x000005);
      scene.fog = new THREE.FogExp2(0x000005, 0.025);
      dnaAngle = 0;
      dnaTargetY = 0;
    }
    lastSwitch = Date.now();
  }

  // ── Animation loop ───────────────────────────────────────────
  let time = 0;

  function animate() {
    requestAnimationFrame(animate);
    time += 0.01;

    if (Date.now() - lastSwitch > switchInterval) switchMode();

    if (currentMode === 'galaxy' && galaxyPoints) {
      galaxyPoints.rotation.y += 0.001;
      camera.lookAt(scene.position);
    }

    if (currentMode === 'dna') {
      // Orbit camera around DNA
      dnaAngle += DNA_ORBIT_SPEED;

      // Vertical travel
      dnaTargetY += DNA_TRAVEL_SPEED * dnaTravelDir;
      if (dnaTargetY >  DNA_TRAVEL_LIMIT) dnaTravelDir = -1;
      if (dnaTargetY < -DNA_TRAVEL_LIMIT) dnaTravelDir =  1;

      // Slight wobble on top of orbit (figure-8 feel)
      const wobbleX = Math.sin(time * 0.4) * DNA_WOBBLE_AMP;
      const wobbleZ = Math.cos(time * 0.27) * DNA_WOBBLE_AMP * 0.5;

      camera.position.set(
        Math.cos(dnaAngle) * DNA_ORBIT_RADIUS + wobbleX,
        dnaTargetY + Math.sin(time * 0.3) * 0.8,
        Math.sin(dnaAngle) * DNA_ORBIT_RADIUS + wobbleZ
      );
      camera.lookAt(0, dnaTargetY * 0.5, 0);

      // Pulse base spheres
      dnaPulseObjects.forEach(obj => {
        const p = 1.0 + 0.18 * Math.sin(time * 2.5 + obj.userData.phase);
        obj.scale.setScalar(p);
      });

      // Slowly rotate the whole DNA a tiny bit for extra life
      dnaGroup.rotation.y += 0.0008;
    }

    renderer.render(scene, camera);
  }

  animate();

  window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  });
</script>

<style>
  #animated-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
  }
</style>
